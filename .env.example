# ── Supabase ─────────────────────────────────────────────
# Wajib. Sumber: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Anon key — AMAN diekspos ke browser (dilindungi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — JANGAN PERNAH diekspos ke client. Server-only.
# Lihat PRD #44: jangan expose SUPABASE_SERVICE_ROLE_KEY ke client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=sewawebmurah.com

# ── Cron automation (PRD #38/#45) ──
# Wajib agar route /api/cron/automation aktif. Isi string acak panjang, mis:
#   openssl rand -hex 32
CRON_SECRET=your-random-cron-secret

# ── Pembayaran MANUAL (aktif saat ini) ──
# Nominal rekening TIDAK di env — diatur dari /admin/settings
# (tabel system_settings: manual_bank_name, manual_account_number,
#  manual_account_holder, manual_instructions). Sudah ter-seed:
#  DANA 082336939662 a/n Angga Bayu Setyawan.

# ── Payment Gateway provider (OPSIONAL — belum dipakai) ──
# Biarkan kosong sampai fase integrasi Midtrans/Xendit/Duitku.
PAYMENT_GATEWAY=
PAYMENT_SERVER_KEY=
PAYMENT_CLIENT_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_URL=

# ── Email provider (OPSIONAL — PRD #34/#39) ──
# Saat ini notifikasi hanya masuk dashboard. Isi saat siap kirim email:
# pilih provider di /admin/settings → tab Email.
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=noreply@sewawebmurah.com
