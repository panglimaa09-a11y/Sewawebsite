# ── Supabase ─────────────────────────────────────────────
# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Anon key — AMAN diekspos ke browser (dilindungi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — JANGAN PERNAH diekspos ke client. Server-only.
# Lihat PRD #44: jangan expose SUPABASE_SERVICE_ROLE_KEY ke client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Payment Gateway (ganti sesuai provider: midtrans/xendit/duitku) ──
PAYMENT_GATEWAY=midtrans
PAYMENT_SERVER_KEY=your-server-key
PAYMENT_CLIENT_KEY=your-client-key
PAYMENT_WEBHOOK_SECRET=your-webhook-secret
PAYMENT_WEBHOOK_URL=https://your-domain.com/api/webhooks/payment

# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=sewawebmurah.com

# ── Cron automation (PRD #38/#45) ──
CRON_SECRET=your-random-cron-secret

# ── Email provider (PRD #34/#39) ──
RESEND_API_KEY=your-resend-api-key
SMTP_URL=smtp://user:password@smtp.host:587
EMAIL_FROM=noreply@sewawebmurah.com
